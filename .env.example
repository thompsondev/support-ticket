# Bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=

# Application ID from https://discord.com/developers/applications -> General Information
CLIENT_ID=

# (Optional) Your dev server ID — registers commands instantly there.
# Leave empty to register commands globally (can take up to 1h to appear).
GUILD_ID=

# --- Web dashboard (optional — bot works without it) ---
# OAuth2 Client Secret from https://discord.com/developers/applications -> OAuth2
OAUTH_CLIENT_SECRET=
# Random string used to sign session cookies
SESSION_SECRET=
# Public URL of the dashboard (must match the OAuth2 redirect you register:
#   <DASHBOARD_URL>/auth/callback  -> add it under OAuth2 -> Redirects)
DASHBOARD_URL=http://localhost:3000
DASHBOARD_PORT=3000

# --- Database ---
# Postgres connection string (recommended for production / hosted deployments).
# Works with Neon, Supabase, Railway, or any Postgres 12+.
# When set, ALL bot + dashboard data lives in Postgres — schema is created
# automatically on first boot. Leave empty to use the embedded SQLite file
# (data/tickets.db) — fine for local dev and small bots.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
# Optional: point this at your provider's pooled endpoint (e.g. Neon -pooler)
# if you run many app instances. DATABASE_URL is used when this is unset.
# DATABASE_URL_POOLED=
# Migrate existing SQLite data into Postgres once:
#   DATABASE_URL="..." npm run db:migrate   (idempotent, safe to rerun)
DATABASE_URL=

# --- Godmode ---
# Comma-separated Discord user IDs of bot owners. Owners get:
#  - full dashboard access to EVERY server the bot is in
#  - global blacklist (blocks a user from tickets in all servers)
#  - per-server disable/enable + force-leave controls
#  - implicit staff permissions in every server
# Find your ID: Discord -> User Settings -> Advanced -> enable Developer Mode -> right-click yourself -> Copy User ID
OWNER_IDS=

# --- AI features (optional — satellite responder + ticket triage) ---
# OpenAI-compatible endpoint. Works with Neon AI Gateway or any compatible API.
# Without these the satellite responder falls back to keyword matching.
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
AI_MODEL=gpt-4o-mini

# --- Support funnel (optional) ---
# Guild ID of your support hub server — the place satellite servers route
# users to. Enables the landing-page "Get Support" button which one-click
# joins logged-in users into this guild (requires the guilds.join scope,
# already requested by /auth/discord).
HUB_GUILD_ID=
# Public invite URL for the hub (e.g. https://discord.gg/xxxx). Used by the
# user-installable "Route to Support" message context command and as the
# satellite auto-arm invite source.
HUB_INVITE=
